        "jsonBody": "={{\n{\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": \"Analyze the provided resume text against the requirements specified in the Job Description text. Extract the requested fields based on how well the candidate matches the role criteria.\\n\\nJob Description Text:\\n\" + $json.targetJobDescription + \"\\n\\nResume Text:\\n\" + $json.text\n        }\n      ]\n    }\n  ],\n  \"generationConfig\": {\n    \"responseMimeType\": \"application/json\",\n    \"responseSchema\": {\n      \"type\": \"OBJECT\",\n      \"properties\": {\n        \"candidate_name\": { \"type\": \"STRING\" },\n        \"ats_score\": { \"type\": \"INTEGER\", \"description\": \"An ATS match score out of 100 based strictly on the provided Job Description requirements\" },\n        \"skills\": { \"type\": \"STRING\", \"description\": \"Comma-separated list of skills present in the resume that match the Job Description\" },\n        \"missing_skills\": { \"type\": \"STRING\", \"description\": \"Comma-separated list of critical skills or requirements requested in the Job Description but missing from the resume\" },\n        \"recommendation\": { \"type\": \"STRING\", \"description\": \"A brief 2-3 sentence alignment summary/hiring recommendation rationale\" }\n      },\n      \"required\": [\"candidate_name\", \"ats_score\", \"skills\", \"missing_skills\", \"recommendation\"]\n    }\n  }\n}\n}}",
